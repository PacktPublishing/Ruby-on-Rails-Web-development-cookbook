<h1 class="text-2xl font-bold mb-4">Projects</h1>
<table class="min-w-full bg-white border border-gray-200 rounded-lg">
  <thead class="bg-gray-50">
    <tr>
      <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">ID</th>
      <th class="px-4 py-2 text-left text-sm font-semibold text-gray-700">Name</th>
      <th class="px-4 py-2 text-center text-sm font-semibold text-gray-700">Actions</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-200">
    <% @projects.each do |project| %>
      <tr>
        <td class="px-4 py-2"><%= project.id %></td>
        <td class="px-4 py-2"><%= project.name %></td>
        <td class="px-4 py-2 text-center">
          <%= link_to 'Edit', edit_admin_project_path(project), class: 'text-blue-600 hover:underline mr-2' %>
          <%= link_to 'Delete', admin_project_path(project), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:underline' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<h1 class="text-2xl font-bold mb-4">Edit User</h1>
<%= link_to "Back to Users",
admin_users_path,
class: "text-sm text-gray-500 hover:underline mb-4 inline-block" %>

<%= form_with model: [:admin, @user], local: true do |form| %>
  <div class="mb-4">
    <%= form.label :email_address, class: "block text-sm font-medium text-gray-700" %>
    <%= form.email_field :email_address,
                     class:
                       "mt-1 block w-full shadow-sm rounded-md border-gray-300 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="mb-4 flex items-center">
    <%= form.check_box :admin, class: "mr-2" %>
    <%= form.label :admin, class: "text-sm text-gray-700" %>
  </div>

  <div class="mb-4">
    <%= form.label :subdomain, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :subdomain,
                    class:
                      "mt-1 block w-full shadow-sm rounded-md border-gray-300 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.submit "Update User", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>


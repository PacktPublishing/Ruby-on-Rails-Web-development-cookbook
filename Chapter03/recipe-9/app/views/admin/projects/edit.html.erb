<h1 class="text-2xl font-bold mb-4">Edit Project</h1>
<%= link_to "Back to Projects",
admin_projects_path,
class: "text-sm text-gray-500 hover:underline mb-4 inline-block" %>

<%= form_with model: [:admin, @project], local: true do |form| %>
  <div class="mb-4">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name,
                    class:
                      "mt-1 block w-full shadow-sm rounded-md border-gray-300 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.submit "Update Project", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>

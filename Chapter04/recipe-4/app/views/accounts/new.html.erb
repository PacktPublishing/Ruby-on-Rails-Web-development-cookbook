<div class="dashboard-container">
  <h2>Workspace</h2>
  <%= form_with model: @account do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name %>

    <h3>Your details</h3>
    <%= f.fields_for :users do |u| %>
      <%= u.label :email %>
      <%= u.email_field :email %>

      <%= u.label :password %>
      <%= u.password_field :password %>

      <%= u.label :password_confirmation %>
      <%= u.password_field :password_confirmation %>
    <% end %>

    <%= f.submit "Create Workspace" %>
  <% end %>
</div>


# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore application configuration
/config/application.yml

# Ignore database files
*.sqlite3
*.sqlite3-*

# Ignore bootsnap cache files
/tmp/cache/bootsnap/

# Ignore uploaded files in development
/storage/

# Ignore node_modules
node_modules/

# Ignore yarn files
yarn-error.log
yarn.lock

# Ignore package-lock.json (npm)
package-lock.json

# Ignore built assets
/public/assets
/app/assets/builds/*

# Ignore coverage reports
/coverage/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore test coverage
/coverage

# Ignore compiled assets
/public/packs
/public/packs-test
/public/assets

# Ignore Yarn integrity file
.yarn-integrity

# Ignore byebug command history file
.byebug_history

# Ignore Spring files
/spring/*.pid

# Ignore credentials
/config/credentials.yml.enc

# Ignore database schema dumps
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Ignore bootsnap cache
/tmp/cache/

# Ignore restart file
/tmp/restart.txt

# Ignore socket files
/tmp/sockets/

# Ignore development database
development.sqlite3
development.sqlite3-shm
development.sqlite3-wal

# Ignore test database
test.sqlite3
test.sqlite3-shm
test.sqlite3-wal

# Ignore production database
production.sqlite3
production.sqlite3-shm
production.sqlite3-wal